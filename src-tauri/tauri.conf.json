{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memechan",
  "version": "0.1.0",
  "identifier": "com.emojidesktop.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Memechan · 表情资料库",
        "width": 1320,
        "height": 860,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "离线表情资料库",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
